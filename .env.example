# Copy to .env and fill in. These are your Polestar ID credentials
# (the same ones you use in the Polestar app).
POLESTAR_USERNAME=
POLESTAR_PASSWORD=

# Optional: restrict to a single car (comma-separate for several)
POLESTAR_VIN=

# Poll interval in seconds (Home Assistant integration default: 60)
POLESTAR_SCAN_INTERVAL=60

# Routing server used to infer trip routes from start/end + odometer distance.
# Default: the public OSRM demo (receives each trip's start/end coordinates).
# Point at a self-hosted OSRM to keep it private, e.g. http://localhost:5000
OSRM_URL=
